{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
  {{- $.Scratch.Add "index" (dict "title" .Title "url" .Permalink "description" (or .Description .Summary) "date" .Date "categories" .Params.categories "tags" .Params.tags "content" (.Plain | truncate 200)) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
